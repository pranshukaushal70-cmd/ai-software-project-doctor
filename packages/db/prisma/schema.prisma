// AI Software Project Doctor — database schema.
// Every analysis stores the analyzer version, commit SHA and scoring weights
// it was produced with so results are reproducible.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Auth

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  repositories     Repository[]
  engineeringTasks EngineeringTask[]
  engineeringRuns  EngineeringRun[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC-SHA256 of the opaque session token; the raw token only lives in the cookie.
  tokenHash  String   @unique
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- Repositories & analyses

enum RepositorySource {
  GITHUB
  GITLAB
  ZIP
  DEMO
}

model Repository {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    RepositorySource
  name      String
  url       String?
  owner     String?
  branch    String?
  /// Key of the uploaded archive in local workspace storage (ZIP sources only).
  uploadKey String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  analyses  Analysis[]
  triages   FindingTriage[]

  @@index([userId, createdAt])
}

enum TriageStatus {
  /// The finding is real but intended (e.g. a deliberate fake secret in a test fixture).
  EXPECTED
  /// The finding is a false positive or accepted risk.
  IGNORED
}

/// A user's decision about one specific finding of a repository. It applies to every
/// analysis of that repository whose finding has the same fingerprint (rule + path +
/// stable key), so it follows the finding across re-analyses but never covers a new or
/// different finding. Triaged findings are still reported; they are only labelled.
model FindingTriage {
  id           String       @id @default(cuid())
  repositoryId String
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fingerprint  String
  /// Rule and path at the time of triage, for display and auditing.
  ruleId       String
  path         String?
  status       TriageStatus
  reason       String?
  /// The user who made the decision (audit only; the repository owns the record).
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([repositoryId, fingerprint])
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AnalysisStage {
  QUEUED
  CLONING
  SCANNING
  PARSING
  SECURITY
  DEPENDENCIES
  ARCHITECTURE
  /// API, database, testing and documentation analysis (Phase 5).
  PRACTICES
  /// Repository intelligence: symbols, call references and resolved file dependencies (Phase 6).
  INDEXING
  GIT
  AI
  REPORT
  COMPLETED
}

enum AnalysisMode {
  LOCAL_ONLY
  AI
}

model Analysis {
  id              String         @id @default(cuid())
  repositoryId    String
  repository      Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  status          AnalysisStatus @default(QUEUED)
  stage           AnalysisStage  @default(QUEUED)
  progress        Int            @default(0)
  mode            AnalysisMode   @default(LOCAL_ONLY)
  analyzerVersion String
  commitSha       String?
  /// Structured repository scan summary (languages, tooling, counts).
  summary         Json?
  healthScore     Int?
  scoreBreakdown  Json?
  weightsUsed     Json?
  /// User-safe error message when status = FAILED.
  error           String?
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  files            File[]
  findings         Finding[]
  metrics          Metric[]
  dependencies     Dependency[]
  nodes            ArchitectureNode[]
  edges            ArchitectureEdge[]
  gitInsights      GitInsight[]
  recommendations  Recommendation[]
  reports          Report[]
  symbols          CodeSymbol[]
  symbolReferences SymbolReference[]
  fileDependencies FileDependency[]
  engineeringTasks EngineeringTask[]

  @@index([repositoryId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------- Analysis results

enum FileKind {
  SOURCE
  TEST
  DOCUMENTATION
  CONFIG
  GENERATED
  BINARY
  OTHER
}

model File {
  id              String            @id @default(cuid())
  analysisId      String
  analysis        Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  path            String
  language        String?
  kind            FileKind
  size            Int
  /// Physical lines.
  lines           Int?
  /// Lines containing code (excludes blank and comment-only lines).
  loc             Int?
  /// Logical lines: statement and declaration nodes.
  lloc            Int?
  commentLines    Int?
  blankLines      Int?
  functionCount   Int?
  classCount      Int?
  maxComplexity   Int?
  avgComplexity   Float?
  maxNesting      Int?
  /// Lines that are part of a detected clone.
  duplicatedLines Int?
  /// Syntax-error nodes from parser recovery; metrics for such files are approximate.
  parseErrors     Int?
  /// Module specifiers imported/included by the file (capped).
  imports         String[]
  /// Names the file exports (capped).
  exports         String[]
  /// SHA-256 of the file's bytes (text files within the size limit); identifies unchanged files across analyses.
  contentHash     String?
  findings        Finding[]
  metrics         Metric[]
  symbols         CodeSymbol[]
  references      SymbolReference[]
  dependenciesOut FileDependency[]  @relation("dependencyFrom")
  dependenciesIn  FileDependency[]  @relation("dependencyTo")

  @@unique([analysisId, path])
  @@index([analysisId, kind])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCategory {
  CODE_QUALITY
  SECURITY
  SECRET
  DEPENDENCY
  ARCHITECTURE
  API
  DATABASE
  TESTING
  DOCUMENTATION
  GIT
  DEVOPS
}

model Finding {
  id              String          @id @default(cuid())
  analysisId      String
  analysis        Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId          String?
  file            File?           @relation(fields: [fileId], references: [id], onDelete: SetNull)
  category        FindingCategory
  type            String
  severity        Severity
  ruleId          String
  title           String
  line            Int?
  endLine         Int?
  /// Always redacted — raw secrets are never persisted.
  evidence        String?
  impact          String?
  recommendation  String?
  /// Stable hash of (ruleId, path, normalised evidence) for de-duplication across runs.
  fingerprint     String
  /// Structured measurements behind the finding (value, limit, related location, …).
  data            Json?
  /// Analyzer module and version that produced the finding, for reproducibility.
  analyzer        String
  analyzerVersion String
  createdAt       DateTime        @default(now())
  fixes           FixSuggestion[]

  @@index([analysisId, severity])
  @@index([analysisId, category])
  @@index([analysisId, fileId])
  @@index([fingerprint])
}

model Metric {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String?
  file       File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  key        String
  value      Float

  @@index([analysisId, key])
}

model Dependency {
  id              String   @id @default(cuid())
  analysisId      String
  analysis        Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ecosystem       String
  name            String
  versionSpec     String?
  resolvedVersion String?
  direct          Boolean  @default(true)
  dev             Boolean  @default(false)
  manifestPath    String
  latestVersion   String?
  vulnIds         String[]
  /// Where vulnerability / version data came from, e.g. "osv.dev".
  dataSource      String?
  unusedCandidate Boolean  @default(false)

  @@index([analysisId, ecosystem])
}

enum NodeKind {
  FILE
  MODULE
  LAYER
  PACKAGE
}

model ArchitectureNode {
  id         String             @id @default(cuid())
  analysisId String
  analysis   Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  key        String
  kind       NodeKind
  label      String
  layer      String?
  metrics    Json?
  outgoing   ArchitectureEdge[] @relation("edgeFrom")
  incoming   ArchitectureEdge[] @relation("edgeTo")

  @@unique([analysisId, key])
}

model ArchitectureEdge {
  id         String           @id @default(cuid())
  analysisId String
  analysis   Analysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fromId     String
  from       ArchitectureNode @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         ArchitectureNode @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind       String           @default("import")
  weight     Int              @default(1)
  inCycle    Boolean          @default(false)

  @@index([analysisId])
}

// ---------------------------------------------------------------- Repository intelligence (Phase 6)

enum SymbolKind {
  FUNCTION
  CLASS
  METHOD
  INTERFACE
  TYPE
  ENUM
  CONSTANT
  VARIABLE
}

/// A declaration found in a source or test file (TypeScript, JavaScript, Python).
model CodeSymbol {
  id         String            @id @default(cuid())
  analysisId String
  analysis   Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId     String
  file       File              @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// Stable within the analysis: path, qualified name and an ordinal for duplicates.
  key        String
  name       String
  kind       SymbolKind
  /// Enclosing class (methods) or function (nested declarations).
  parent     String?
  exported   Boolean           @default(false)
  isDefault  Boolean           @default(false)
  line       Int
  endLine    Int
  /// Declaration head (name and parameters), redacted and truncated.
  signature  String?
  calls      SymbolReference[] @relation("referenceFrom")
  callers    SymbolReference[] @relation("referenceTarget")

  @@unique([analysisId, key])
  @@index([analysisId, name])
  @@index([fileId])
}

/// A call site. `targetSymbolId` is set only when the call resolves unambiguously (imported or local declaration, `this`/`self` method).
model SymbolReference {
  id             String      @id @default(cuid())
  analysisId     String
  analysis       Analysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fileId         String
  file           File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fromSymbolId   String?
  fromSymbol     CodeSymbol? @relation("referenceFrom", fields: [fromSymbolId], references: [id], onDelete: SetNull)
  targetSymbolId String?
  targetSymbol   CodeSymbol? @relation("referenceTarget", fields: [targetSymbolId], references: [id], onDelete: SetNull)
  /// Called name: the function, or the method for `a.b()`.
  name           String
  receiver       String?
  line           Int

  @@index([analysisId, name])
  @@index([targetSymbolId])
  @@index([fromSymbolId])
  @@index([fileId])
}

enum DependencyKind {
  INTERNAL
  EXTERNAL
  BUILTIN
  UNRESOLVED
}

/// One import of a source or test file, resolved statically: to a repository file (INTERNAL), a package, the standard library, or nothing.
model FileDependency {
  id          String         @id @default(cuid())
  analysisId  String
  analysis    Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fromFileId  String
  fromFile    File           @relation("dependencyFrom", fields: [fromFileId], references: [id], onDelete: Cascade)
  toFileId    String?
  toFile      File?          @relation("dependencyTo", fields: [toFileId], references: [id], onDelete: Cascade)
  specifier   String
  kind        DependencyKind
  packageName String?

  @@index([fromFileId])
  @@index([toFileId])
  @@index([analysisId, kind])
}

model GitInsight {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind       String
  path       String?
  data       Json

  @@index([analysisId, kind])
}

enum RecommendationSource {
  AI
  RULE
}

enum Effort {
  SMALL
  MEDIUM
  LARGE
}

model Recommendation {
  id                 String               @id @default(cuid())
  analysisId         String
  analysis           Analysis             @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  phase              Int
  priority           Int
  title              String
  rationale          String
  effort             Effort?
  evidenceFindingIds String[]
  source             RecommendationSource

  @@index([analysisId, phase])
}

model FixSuggestion {
  id            String   @id @default(cuid())
  findingId     String
  finding       Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  originalCode  String
  suggestedCode String
  explanation   String
  provider      String
  model         String
  createdAt     DateTime @default(now())

  @@index([findingId])
}

enum ReportFormat {
  PDF
  JSON
  MARKDOWN
  HTML
}

model Report {
  id          String       @id @default(cuid())
  analysisId  String
  analysis    Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  format      ReportFormat
  storagePath String
  createdAt   DateTime     @default(now())

  @@index([analysisId])
}

// ---------------------------------------------------------------- engineering planner (Phase 7)

enum EngineeringPlanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// A developer task to plan against one analysis. Planning only: nothing is executed.
model EngineeringTask {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId  String
  analysis    Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  request     String
  /// Optional repository-relative directory the plan is limited to.
  scope       String?
  /// User constraints (string[]).
  constraints Json
  createdAt   DateTime          @default(now())
  plans       EngineeringPlan[]

  @@index([userId, createdAt])
  @@index([analysisId, createdAt])
}

/// One planning attempt. Stores provider metadata and the validation result, never credentials.
model EngineeringPlan {
  id               String                    @id @default(cuid())
  taskId           String
  task             EngineeringTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status           EngineeringPlanStatus     @default(PENDING)
  provider         String
  /// Model that served the request (requested model until it completes).
  model            String
  /// The validated plan (ValidatedPlan) when COMPLETED.
  plan             Json?
  /// ValidationReport: status, issues, model and adjusted confidence.
  validation       Json?
  validationStatus String?
  confidence       Float?
  /// Context retrieval statistics (search hits, candidate files, evidence count, truncation).
  contextStats     Json?
  inputTokens      Int?
  outputTokens     Int?
  durationMs       Int?
  /// Machine-readable failure reason and user-safe message when FAILED.
  failureReason    String?
  error            String?
  createdAt        DateTime                  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  /// When the owner approved the plan for the code engine (Phase 8): the first gate before any change is generated.
  approvedAt       DateTime?
  evidence         EngineeringPlanEvidence[]
  runs             EngineeringRun[]

  @@index([taskId, createdAt])
}

/// The deterministic evidence bundle a plan was generated from; plan claims cite `ref`.
model EngineeringPlanEvidence {
  id      String          @id @default(cuid())
  planId  String
  plan    EngineeringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// E1, E2, ...
  ref     String
  kind    String
  path    String?
  symbol  String?
  line    Int?
  summary String
  source  String

  @@unique([planId, ref])
}

// ---------------------------------------------------------------- code engine (Phase 8)

/// Lifecycle of a code-engine run; transitions are checked against @pd/shared/engine.
enum EngineeringRunStatus {
  QUEUED
  MATERIALIZING
  GENERATING
  VALIDATING
  APPLYING
  /// Waiting for the user to approve (or skip) the sandboxed test command.
  AWAITING_APPROVAL
  INSTALLING
  TESTING
  REPAIRING
  READY_FOR_REVIEW
  DISCARDED
  FAILED
  CANCELLED
}

enum EngineeringChangeOperation {
  CREATE
  MODIFY
  DELETE
}

enum EngineeringChangeStatus {
  /// Passed validation and was applied in the isolated workspace.
  APPLIED
  /// Rejected by validation; kept, with its flags, so the user sees what was refused.
  REJECTED
}

enum SandboxExecutionKind {
  INSTALL
  TEST
}

/// One attempt to turn an approved plan into a reviewed change. Works on an isolated copy of the analysed
/// commit; never commits, pushes or opens pull requests. The result is a patch the user downloads.
model EngineeringRun {
  id                  String               @id @default(cuid())
  planId              String
  plan                EngineeringPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              EngineeringRunStatus @default(QUEUED)
  provider            String
  /// Model that served the latest request (requested model until then).
  model               String
  /// The commit the workspace was materialised at (the analysis's commitSha for git sources).
  commitSha           String?
  /// Budgets, fixed when the run is created (ENGINEERING_RUN_LIMITS).
  maxIterations       Int
  tokenBudget         Int
  maxDurationSeconds  Int
  /// Current edit-generation iteration (0 before the first one).
  iteration           Int                  @default(0)
  inputTokens         Int                  @default(0)
  outputTokens        Int                  @default(0)
  /// Allowlisted test command template id; never text chosen by a model.
  testCommand         String?
  /// Whether the user approved the separate, network-enabled dependency install step.
  installApproved     Boolean              @default(false)
  /// The second gate: when the user approved running `testCommand` in the sandbox.
  executionApprovedAt DateTime?
  /// Set by a cancel request while the worker holds the run; the worker stops at the next step.
  cancelRequestedAt   DateTime?
  /// Machine-readable failure reason and user-safe message when FAILED.
  failureReason       String?
  error               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  startedAt           DateTime?
  finishedAt          DateTime?
  changes             EngineeringChange[]
  executions          SandboxExecution[]
  events              EngineeringRunEvent[]

  @@index([planId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

/// One proposed file change of one iteration, with its validation result and unified diff.
model EngineeringChange {
  id         String                     @id @default(cuid())
  runId      String
  run        EngineeringRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  iteration  Int
  /// Repository-relative path.
  path       String
  operation  EngineeringChangeOperation
  status     EngineeringChangeStatus
  reason     String
  /// SHA-256 of the file before and after the change (null when it does not exist).
  beforeHash String?
  afterHash  String?
  /// Unified diff of an applied change (redacted); null when rejected.
  diff       String?
  additions  Int                        @default(0)
  deletions  Int                        @default(0)
  /// Validation issue codes for this change (string[]).
  flags      Json
  createdAt  DateTime                   @default(now())

  @@index([runId, iteration])
}

/// One command run in the disposable sandbox container. Output is redacted and truncated before storage.
model SandboxExecution {
  id              String               @id @default(cuid())
  runId           String
  run             EngineeringRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  iteration       Int
  kind            SandboxExecutionKind
  /// Allowlisted command template id and the exact command line shown to the user.
  commandId       String
  command         String
  /// Container image, pinned by digest.
  image           String
  /// Whether the container had network access (only the install step can).
  network         Boolean              @default(false)
  exitCode        Int?
  timedOut        Boolean              @default(false)
  durationMs      Int?
  output          String               @default("")
  outputTruncated Boolean              @default(false)
  startedAt       DateTime             @default(now())
  finishedAt      DateTime?

  @@index([runId, startedAt])
}

/// Audit log of a run: every status change, approval and cancellation, with who caused it.
model EngineeringRunEvent {
  id         String                @id @default(cuid())
  runId      String
  run        EngineeringRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// "status", "approval", "cancel-requested", …
  type       String
  /// "user" or "worker".
  actor      String
  fromStatus EngineeringRunStatus?
  toStatus   EngineeringRunStatus?
  /// User-safe description; never prompts, file contents or credentials.
  message    String
  data       Json?
  createdAt  DateTime              @default(now())

  @@index([runId, createdAt])
}
