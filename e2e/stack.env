# Throwaway values for the end-to-end stack only (docker-compose.e2e.yml). They protect a
# database that exists for one test run on a network nothing else can reach; they are not
# secrets. Never reuse them for a real deployment (use scripts/setup-env.mjs and .env).
POSTGRES_PASSWORD=e2e-only-database-password
JWT_SECRET=e2e-only-session-secret-0123456789abcdefghijklmnop
APP_URL=http://localhost:3000
LOG_LEVEL=info
