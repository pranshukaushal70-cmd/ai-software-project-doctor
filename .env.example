# ---------------------------------------------------------------
# AI Software Project Doctor — environment configuration
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL (docker compose service "postgres")
# docker-compose.yml reads POSTGRES_* from this file; DATABASE_URL must use the same
# credentials. `node scripts/setup-env.mjs` replaces the placeholder password below
# with a random one in both places. POSTGRES_* only apply when the database volume is
# first created; to change the password of an existing database, use ALTER USER.
POSTGRES_USER=doctor
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=project_doctor
DATABASE_URL=postgresql://doctor:change-me-local-db-password@localhost:5432/project_doctor

# Redis (docker compose service "redis") — used by BullMQ and rate limiting
REDIS_URL=redis://localhost:6379

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- AI providers (optional; analysis works without any) ---------
# Engineering planner provider: "anthropic" (needs ANTHROPIC_API_KEY) or
# "baseline" (deterministic evidence-only plans, no LLM, no key).
# Keys are read from the environment only; they are never stored or logged.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=claude-opus-5-5
# Reserved for future providers
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Code engine sandbox (Phase 8) -------------------------------
# Runs a repository's tests in disposable Docker containers, only after the
# user approves the exact command: no network, read-only root filesystem,
# unprivileged user, all capabilities dropped, resource limits, no host
# environment or mounts. Off by default: without it, runs end with a diff
# for review and no repository code ever runs. The worker needs access to a
# Docker engine running Linux containers (see docs/security.md).
SANDBOX_ENABLED=false
# Separate, network-enabled dependency install step (npm ci / pip wheels only,
# never install scripts), also approved per run. Off by default.
SANDBOX_INSTALL_ENABLED=false
# runc (default) or runsc (gVisor, if installed on the Docker host).
SANDBOX_RUNTIME=runc
# Images must be pinned by digest; empty uses the built-in pinned defaults.
SANDBOX_IMAGE_NODE=
SANDBOX_IMAGE_PYTHON=
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_INSTALL_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS=256
# Planner and code-engine jobs the worker processes at once.
ENGINE_CONCURRENCY=1

# --- Optional GitHub OAuth / token for higher API rate limits -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Analyzer limits ---------------------------------------------
# Where uploaded ZIPs and cloned repositories are stored temporarily.
# Defaults to <os tmpdir>/project-doctor when empty.
WORKSPACE_DIR=
MAX_UPLOAD_MB=50
MAX_EXTRACTED_MB=500
MAX_ZIP_ENTRIES=20000
MAX_COMPRESSION_RATIO=100
MAX_FILE_KB=1024
CLONE_TIMEOUT_SECONDS=120
CLONE_DEPTH=500

# --- Dependency vulnerability lookup (OSV.dev) -------------------
# Sends package names and exact versions (nothing else) to https://api.osv.dev.
# npm and Cargo packages shown to come from a private registry (by the lockfile,
# or for npm the repository's .npmrc/.yarnrc.yml) are withheld. PyPI, Maven and
# Go do not record the registry, so their exact-version packages are always sent.
# Set to false to send nothing.
OSV_ENABLED=true
OSV_TIMEOUT_SECONDS=90
